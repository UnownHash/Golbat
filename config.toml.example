port = 9001             # Listening port for golbat
#grpc_port = 50001      # Listening port for grpc (raw ingest + GolbatApi, which uses api_secret)
raw_bearer = ""         # Raw bearer (password) required
api_secret = "golbat"   # Golbat secret required on api calls (blank for none)
api_docs = true         # Serve interactive API docs at /docs (+ /openapi.json, /schemas); never requires the api secret

pokemon_memory_only = true  # Use in-memory storage for pokemon only
#preserve_pokemon = false   # Save pokemon to DB on shutdown, restore on startup (for memory-only mode)
# store_username: Persist the reporting account's username on the pokemon row (default off).
# Off means pokemon webhooks report whichever account triggered the save, not the first account
# to see the pokemon. It also affects saves with no triggering account at all — e.g. the
# proactive IV re-save (weather_iv.go) always passes none. With the option off there is no
# stored username to fall back to, so those webhooks carry "username": null.
store_username = false
preload = false         # preload: Pre-load objects into cache on startup (faster initial responses, but increases startup time)
fort_in_memory = false  # fort_in_memory: Keep forts in memory for api lookups [experimental]
# derive_iv: fill IVs, level, size and moves on a sighting by replaying the game's own
# PRNG from the encounter id, rather than leaving them absent until a real encounter.
# Default true. Turning it off restores stock behaviour for those fields — derived
# despawn times are separate and are not affected. Note that with this on, almost every
# Pokemon carries IVs, so a weather change sweeps the whole cell rather than the few
# that had been encountered.
derive_iv = true

# derive_strong: with derive_iv on, also fill in strong (mighty) Pokemon's IVs, level and size,
# which the game rolls differently from ordinary ones. Their moves are left for an encounter,
# since events can fix them. Default true; turn it off if tools/derivecheck.py reports strong
# disagreements.
derive_strong = true

# derive_despawn: give a Pokemon or tappable at a spawnpoint whose despawn time has not been
# observed an unverified despawn time derived from the spawnpoint id, rather than a 20-minute
# guess. Default true; turn it off only if the game changes how despawn times are placed and
# golbat has not yet been updated to match. Observed despawn times are used either way.
derive_despawn = true

# ditto_derivation: mark a sighting as a Ditto when its encounter id derives one, rather
# than waiting for a real encounter to confirm it. The displayed species and form must also
# be in ditto_pool below. Default true; turn it off only if the game changes how Ditto is
# chosen and golbat has not yet been updated to match.
ditto_derivation = true
# ditto_pool: the disguises ditto_derivation treats as eligible. Leave it empty to use the published
# pool, which golbat fetches at startup and every 6 hours, caches under cache/ditto-pool.json,
# and falls back to a copy built into the binary when neither can be read.
#
# Any entries here override the published pool entirely. It is still fetched and cached while
# an override is in force, and each refresh logs how it differs from your list, so you can see
# when it has caught up and remove yours.
#
# Each entry is "<species>" or "<species>:<form>". A bare species means that species' NORMAL
# form and form 0, the two spellings the game reports for an ordinary disguise and the
# published pool lists — an ordinary Growlithe is a disguise, a Hisuian Growlithe is not, and
# they differ only by form. Name a form to match that form alone. A species with no
# NORMAL form at all (Lycanroc, Squawkabilly) must name its form, e.g. "931:2987"; a bare entry
# for one is refused at startup.
ditto_pool = []
# derivation_log: emit one [DERIVE] line for each encounter where a derived value (IVs,
# level, size, moves) disagrees with what the game reported, an observed move is outside
# the pool the derivation draws from, or the Ditto signals conflict — the roll marking
# what detectDitto refutes, detectDitto confirming a Ditto the roll did not fire for, or
# the stats showing a Ditto where the roll did not fire. Each line says why in
# logged_because. Agreements are counted, not logged. Read it with tools/derivecheck.py.
# The Prometheus derivation_* counters and the [DITTO] unknown-disguise warning do not
# depend on this and are always on.
derivation_log = false

[koji]
url = "http://{koji_url}/api/v1/geofence/feature-collection/{golbat_project}"
bearer_token = "secret"

[cleanup]
pokemon = true                  # Keep pokemon table is kept nice and short
incidents = true                # Remove incidents after expiry
station_battles = true          # Remove station battles after expiry
quests = true                   # Remove quests after expiry
tappables = true                # Remove tappables after expiry
stats = true                    # Enable/Disable stats history
stats_days = 7                  # Remove entries from "pokemon_stats", "pokemon_shiny_stats", "pokemon_iv_stats", "pokemon_hundo_stats", "pokemon_nundo_stats", "invasion_stats", "quest_stats", "raid_stats" after x days
device_hours = 24               # Remove devices from in memory after not seen for x hours
forts_stale_threshold = 3600    # Seconds before a fort is considered stale (default: 1 hour)

[logging]
debug = false
api_request_logging = false     # Log raw request/response bodies of all Huma /api endpoints (large; off by default)
save_logs = true
max_size = 50                   # Size in MB
max_backups = 10                # Amount of files to keep
max_age = 30                    # Day(s) to keep files
compress = true                 # Compress to gz archive

[database]
user = ""
password = ""
address = "127.0.0.1:3306"
db = ""
max_pool = 100                  # Maximum database connection pool size

[pvp]
enabled = true
include_hundos_under_cap = false
level_caps = [50, 51]           # Level caps used in PVP rankings
#ranking_comparator = "prefer_higher_cp"  # Options: "prefer_higher_cp", "prefer_lower_cp" (default: tied rankings)

# you can enable prometheus by uncommenting this section
#[prometheus]
#enabled = true
#token = ""                 # Optional auth token for /metrics endpoint

# You can specify more than one webhook destination by including the [[webhooks]] section
# multiple times.  The hook types can optionally be filtered by using the types array

[[webhooks]]
url = "http://localhost:4201"
# types if specified can be...
# types = ["pokemon", "pokemon_iv", "pokemon_no_iv", "gym", "invasion", "quest", "pokestop", "raid", "weather", "fort_update", "max_battle"]
# "pokemon" includes both with ivs and without. "pokemon_iv" will only be encountered pokemon. "pokemon_no_iv" may be nearby pokemon that have not been encountered (yet).

#[[webhooks]]
#url = "http://localhost:4202"
#types = ["raid"]
#headers = ["X-Poracle-Secret:abc", "Other-Header:def"]

#[[webhooks]]
#url = "http://localhost:4202"
#types = ["raid"]
#areas = ["London/*", "*/Harrow", "Harrow"]
# exclude_areas suppresses messages from the listed geofences/areas. If an
# area appears in both areas and exclude_areas, the exclusion wins.
#exclude_areas = ["London/Westminster", "*/Wembley"]

[tuning]
max_pokemon_distance = 100  # Maximum distance in kilometers for searching pokemon
max_pokemon_results = 3000  # Maximum number of pokemon to return
max_fort_results = 9000  # Maximum number of forts (gyms/pokestops/stations) to return per in-memory scan; separate from max_pokemon_results so the fort map-data API can be tuned independently
extended_timeout = false    # Extend timeouts for processing, hopefully not needed
write_behind_startup_delay = 120    # Writes will be queued for this quiet time
write_behind_worker_count = 16      # Maximum number of parallel batch writes.
                                    # One worker sustains thousands of rows/sec; higher values
                                    # only engage during bursts, where they amplify write
                                    # pressure on the DB (queueing app-side coalesces writes
                                    # instead). Raise only if write-behind latency grows in
                                    # steady state (golbat_db_query_duration_seconds{caller=~"writebehind.*"}).
write_behind_batch_size = 50        # Number of entries per batch write
write_behind_batch_timeout = 100    # Max wait time in ms before flushing partial batch
profile_routes = false      # Turn on debugging endpoints
profile_contention = false  # Collect data for contention (use with above) - has a perf impact
s2_cell_lookup = false      # Pre-compute S2 cell lookup for faster geofence matching. Trades memory (~60x geofence file size) for ~7x faster lookups. (default: false)
# raw_processing_concurrency = 0  # max concurrent raw-proto decoders; 0 = auto (4x CPUs, max 96), -1 = unlimited
# raw_processing_queue_factor = 32  # parked decode queue cap (x concurrency limit); rides out brief DB stalls before shedding
# slow_db_query_ms = 0         # log [DB_SLOW] (with pool stats) for entity queries and write-behind batch flushes slower than this many ms; 0 = default (1000), -1 = disabled
# gogc_percent = 0             # runtime GC target (Go default 100). Higher = fewer GC cycles,
                               # more peak heap (~(1+n/100)x live). Large-RAM instances with big
                               # live heaps can reclaim 10%+ CPU at 300-400. 0 = Go default.
# go_mem_limit_mib = 0         # soft memory limit (GOMEMLIMIT) in MiB; 0 = off. Set below
                               # available RAM as a backstop when raising gogc_percent.

# When enabled, reduce_updates will make fort update debounce windows much longer
# to reduce database churn. Specifically, gym/pokestop/station debounce will be
# extended from 15 minutes (900s) to 12 hours (43200s) and spawnpoint last_seen
# will be updated every 12 hours instead of the default 6 hours.
reduce_updates = false

[weather]
proactive_iv_switching = true       # Enable proactive IV switching upon weather changes (default: true)
proactive_iv_switching_to_db = false # Write proactive IV changes to database (default: false)

# Scan rules allow controlling which game objects are processed based on area or scanner context.
# Rules are processed in order - first match applies.
# Available options: pokemon, wild_pokemon, nearby_pokemon, nearby_cell_pokemon, weather, cells,
#                   pokestops, gyms, stations, tappables, proactive_iv_switching
#
# Example: Disable nearby pokemon in MainArea, allow everything from Scout context, disable all pokemon elsewhere

# Under heavy load you will gain an advantage from disabling nearby_pokemon
# nearby_cell_pokemon (nearby pokemon with no pokestop, placed at the S2 cell centre) is off unless
# a rule sets it to true; nearby_pokemon does not enable it
# Contexts sent from dragonite are Fort, Pokemon, Quest, Scout, RarePokemon

#[[scan_rules]]
#areas = ["MainArea"]
#nearby_pokemon = false
#
#[[scan_rules]]
#context = ["Scout"]
#
#[[scan_rules]]
#pokemon = false

#[stats_intervals]
#pokemon_stats_interval_minutes = 1     # Interval for writing pokemon stats (default: 1 minute)
#pokemon_count_interval_minutes = 10    # Interval for writing pokemon count stats (default: 10 minutes)
#raid_stats_interval_minutes = 10       # Interval for writing raid stats (default: 10 minutes)
#invasion_stats_interval_minutes = 15   # Interval for writing invasion stats (default: 15 minutes)
#quest_stats_interval_minutes = 15      # Interval for writing quest stats (default: 15 minutes)
